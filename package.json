{
  "name": "localstudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "vlt@1.0.4",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vlt run -w apps/landing build && vlt run -w apps/editor build && vlt run -w apps/joystick build && vlt run -w apps/docs build && node scripts/prepare-pages-artifacts.mjs",
    "build:docs": "vlt run -w apps/docs build",
    "build:landing": "vlt run -w apps/landing build",
    "build:editor": "vlt run -w apps/editor build",
    "build:joystick": "vlt run -w apps/joystick build",
    "dev:docs": "vlt run -w apps/docs dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "playwright:install:chromium": "playwright install chromium",
    "playwright:install-deps:chromium": "playwright install-deps chromium",
    "typecheck": "vlt run --recursive --if-present typecheck",
    "test": "vlt run --recursive --if-present test",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:coverage": "vlt run test:e2e:coverage:editor && vlt run test:e2e:coverage:landing && vlt run test:e2e:coverage:public-deck && vlt run test:e2e:coverage:webmcp && vlt run test:e2e:coverage:joystick",
    "test:e2e:coverage:editor": "node scripts/run-e2e-coverage.mjs editor",
    "test:e2e:coverage:editor-full": "E2E_SERVER=dev node scripts/run-e2e-coverage.mjs editor-full",
    "test:e2e:coverage:joystick": "node scripts/run-e2e-coverage.mjs joystick",
    "test:e2e:coverage:landing": "node scripts/run-e2e-coverage.mjs landing",
    "test:e2e:coverage:public-deck": "node scripts/run-e2e-coverage.mjs public",
    "test:e2e:coverage:webmcp": "node scripts/run-e2e-coverage.mjs webmcp",
    "test:e2e:coverage:report": "playwright test --project=chromium --output=test-results/coverage-report-only tests/e2e/support/coverage-report-only.spec.ts",
    "test:e2e:coverage:editor-contracts": "E2E_SERVER=dev node scripts/run-e2e-coverage.mjs editor-contracts",
    "test:e2e:coverage:joystick-contracts": "E2E_SERVER=dev node scripts/run-e2e-coverage.mjs joystick-contracts",
    "test:e2e:all": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vlt run -w apps/editor test:watch",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@localstudio/analytics-config": "*",
    "@localstudio/app-routes": "*",
    "@localstudio/presenter-remote": "*",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fflate": "^0.8.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "monocart-coverage-reports": "^2.12.12",
    "peer": "^1.0.2",
    "playwright": "^1.61.1",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.8.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
